{
    "name": "contenir/contenir-mvc-workflow",
    "description": "Builds laminas-mvc routes and laminas-navigation pages from a tree of Contenir resources, one workflow per resource type",
    "license": "BSD-3-Clause",
    "type": "library",
    "keywords": [
        "contenir",
        "laminas",
        "mvc",
        "routing",
        "navigation"
    ],
    "homepage": "https://contenir.com.au",
    "support": {
        "docs": "https://docs.contenir.com.au/contenir-mvc-workflow/",
        "issues": "https://contenir.com.au/issues",
        "source": "https://github.com/contenir/contenir-mvc-workflow"
    },
    "require": {
        "php": "~8.3.0 || ~8.4.0 || ~8.5.0",
        "contenir/contenir-metadata": "dev-v2/qa-tools as 2.0.x-dev",
        "laminas/laminas-cache": "^3.12",
        "laminas/laminas-cache-storage-adapter-filesystem": "^2.4",
        "laminas/laminas-mvc": "^3.7",
        "laminas/laminas-navigation": "^2.19",
        "laminas/laminas-router": "^3.13",
        "laminas/laminas-servicemanager": "^3.22",
        "psr/container": "^1.1 || ^2.0"
    },
    "require-dev": {
        "laminas/laminas-http": "^2.19",
        "php-db/phpdb-qa-tools": "0.1.x-dev",
        "phpunit/phpunit": "^11.5.42"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Contenir\\Mvc\\Workflow\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ContenirTest\\Mvc\\Workflow\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.3.99"
        },
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "2.0.x-dev"
        },
        "laminas": {
            "component": "Contenir\\Mvc\\Workflow",
            "config-provider": "Contenir\\Mvc\\Workflow\\ConfigProvider"
        }
    },
    "scripts": {
        "check": [
            "@cs-check",
            "@static-analysis",
            "@test",
            "@test-integration"
        ],
        "cs-check": [
            "mago format --check",
            "mago lint"
        ],
        "cs-fix": [
            "mago format",
            "mago lint --fix"
        ],
        "static-analysis": "mago analyze",
        "test": "phpunit --colors=always --testsuite unit",
        "test-coverage": "phpunit --colors=always --coverage-clover clover.xml",
        "test-integration": "phpunit --colors=always --testsuite integration"
    }
}
